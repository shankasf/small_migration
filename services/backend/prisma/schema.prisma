generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  name               String?
  passwordHash       String?
  entraOid           String?                 @unique
  role               String                  @default("analyst") // admin | analyst | auditor
  status             String                  @default("active") // active | restricted | disabled
  tokensValidAfter   DateTime?
  roleManagedLocally Boolean                 @default(false)
  dailyTokenLimit    Int?
  monthlyTokenLimit  Int?
  lastLoginAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  sessions           Session[]
  auditEvents        AuditEvent[]
  usageRecords       UsageRecord[]
  aiActivity         AiActivityLog[]
  integrations       Integration[]
  integrationStates  IntegrationOAuthState[]
  apiKeys            ApiKey[]
  messageFeedback    MessageFeedback[]
}

// Admin-issued credential for calling the REST API from scripts. A key acts as
// the admin who created it, so role, status and access revocation are
// re-checked on every request. Only a SHA-256 digest of the key is stored.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // leading characters of the key, shown to tell keys apart
  keyHash    String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Per-user external system connection. Secret material is encrypted by the
// backend before it reaches PostgreSQL; only non-sensitive metadata is exposed
// through the API.
model Integration {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String // github | gitlab | snowflake | dbt
  status           String    @default("connected")
  displayName      String?
  metadata         Json?
  encryptedSecrets String    @db.Text
  connectedAt      DateTime  @default(now())
  lastVerifiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// Short-lived state for OAuth authorization-code + PKCE callbacks. Rows are
// single-use and never contain provider access tokens.
model IntegrationOAuthState {
  state        String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  codeVerifier String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, provider])
}

model AuditEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. auth.login, session.create, chat.message, file.upload, guardrail.block
  resource  String? // session/file/user id the action touched
  decision  String   @default("allow") // allow | deny | blocked
  dataClass String? // metadata | health-pii
  severity  String   @default("info") // info | warning | critical
  detail    String?  @db.Text // PII-scrubbed JSON detail
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([decision])
  @@index([createdAt])
}

model UsageRecord {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId    String?
  provider     String   @default("openai") // openai | azure
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// One row per observable step of an AI turn: guardrail decisions, each model
// call (with its own token counts and cost), every agent tool call and its
// result, the final output, and the turn summary. Rows are attributed to the
// user whose turn produced them, so the admin portal can show activity per
// user id rather than one undifferentiated firehose. Payload previews are
// truncated and guardrail-filtered before they are written.
model AiActivityLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId    String?
  turnId       String? // groups every event emitted by one chat turn
  step         String // turn.start | guardrail | llm.call | tool.call | tool.result | agent.output | turn.complete | error
  type         String   @default("info") // info | success | progress | tool | usage | error
  message      String   @db.Text
  tool         String?
  provider     String?
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  costUsd      Float    @default(0)
  durationMs   Int?
  detail       String?  @db.Text // JSON: tool args/result previews, guardrail findings
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([turnId])
  @@index([step])
  @@index([createdAt])
}

model Session {
  impactState Json? // Server-owned source confirmation for the current impact analysis.
  id             String            @id @default(uuid())
  name           String            @default("New Chat")
  ownerUserId    String?
  owner          User?             @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Set once the chat's transcript has been replayed into the Agents SDK
  // session store (agent_messages). Sessions that predate SDK-backed memory
  // are seeded lazily on their next turn; null means "not yet replayed".
  memorySeededAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  messages       Message[]
  files          UploadedFile[]
  outputs        GeneratedOutput[]
  libraryFiles   FileAsset[]

  @@index([ownerUserId])
}

model Message {
  id        String            @id @default(uuid())
  sessionId String
  session   Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String            @db.Text
  createdAt DateTime          @default(now())
  outputs   GeneratedOutput[]
  libraryRefs FileReference[]
  searchChunks MessageSearchChunk[]
  fileRefs  MessageFileRef[]
  feedback  MessageFeedback[]

  @@index([sessionId])
}

// One rating per user per assistant response: the thumb is the whole signal,
// the note is optional and always the user's own words. Ratings are editable
// (a thumb can be switched or withdrawn), so a row is the user's current
// verdict rather than an append-only event. `sessionId` is denormalised so the
// admin view can group and link back to a thread without walking Message.
model MessageFeedback {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String
  rating    String // up | down
  score     Int? // 1-5 rubric score; only ever set alongside a thumbs up
  note      String?  @db.Text // guardrail-screened before it is stored
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([createdAt])
  @@index([rating, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
}

model UploadedFile {
  libraryAssets FileAsset[]
  id        String           @id @default(uuid())
  sessionId String
  session   Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename  String
  category  String // "template" | "mapping" | "dbt_add_info" | "dbt_stg_add_info"
  content   String           @db.Text
  createdAt DateTime         @default(now())
  mentions  MessageFileRef[]

  @@unique([sessionId, category])
  @@index([sessionId])
}

// Each row is one immutable generated-file version. Revisions of the same
// filename create new rows (no upsert), each linked to the assistant message
// that produced it — so every chat turn keeps the exact files it delivered.
model GeneratedOutput {
  libraryAssets FileAsset[]
  id         String           @id @default(uuid())
  sessionId  String
  session    Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId  String? // null on rows created before message linking existed
  message    Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  filename   String
  validation Json?
  filepath   String // Logical output reference; content is held in PostgreSQL
  fileType   String // "sql" | "txt"
  content    String           @db.Text
  createdAt  DateTime         @default(now())
  mentions   MessageFileRef[]

  @@index([sessionId])
  @@index([messageId])
}

// One @-mention: a file the user explicitly attached to a chat message from
// the file picker. Kept so a mention survives a reload, so the transcript can
// render the same chips it was sent with, and so a turn's context assembly is
// auditable after the fact. `inlined` records whether the file's full content
// reached the model or only a preview (with the agent free to open the rest
// through get_file_content) — the per-turn token budget decides which.
model MessageFileRef {
  id                String           @id @default(uuid())
  messageId         String
  message           Message          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind              String // upload | output
  uploadedFileId    String?
  uploadedFile      UploadedFile?    @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)
  generatedOutputId String?
  generatedOutput   GeneratedOutput? @relation(fields: [generatedOutputId], references: [id], onDelete: SetNull)
  filename          String
  version           Int              @default(1) // nth revision of this filename in its session
  sourceSessionId   String // chat the file came from (may differ from the message's)
  inlined           Boolean          @default(true)
  tokensEstimate    Int              @default(0)
  createdAt         DateTime         @default(now())

  @@index([messageId])
  @@index([uploadedFileId])
  @@index([generatedOutputId])
}

// Immutable snapshots shared by discovery, previews and explicit chat references.
model FileAsset {
  id          String @id @default(uuid())
  kind        String
  sourceId    String
  uploadedFileId String?
  uploadedFile UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  generatedOutputId String?
  generatedOutput GeneratedOutput? @relation(fields: [generatedOutputId], references: [id], onDelete: Cascade)
  sessionId   String
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename    String
  version     Int
  content     String @db.Text
  contentHash String
  summary     String
  indexStatus String @default("pending")
  indexedAt   DateTime?
  titanIndexedAt DateTime?
  retryAt     DateTime @default(now())
  attempts    Int @default(0)
  createdAt   DateTime @default(now())
  chunks      FileChunk[]
  references  FileReference[]
  @@unique([kind, sourceId, contentHash])
  @@unique([sessionId, kind, filename, version])
  @@index([sessionId, createdAt])
  @@index([indexStatus, retryAt])
}

model FileChunk {
  id        String @id @default(uuid())
  assetId   String
  asset     FileAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ordinal   Int
  content   String @db.Text
  // Legacy OpenAI vector retained for rollback; new search uses Titan only.
  embedding Unsupported("vector(1536)")?
  embeddingTitan Unsupported("vector(1024)")?
  @@unique([assetId, ordinal])
}

model FileReference {
  id         String @id @default(uuid())
  messageId  String
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  assetId    String?
  asset      FileAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  filename   String
  version    Int
  kind       String
  sourceSessionId String
  createdAt  DateTime @default(now())
  @@index([messageId])
  @@index([assetId])
}

// Rebuildable retrieval index; the original transcript remains the durable source.
model MessageSearchChunk {
  id          String @id @default(uuid())
  messageId   String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ordinal     Int
  content     String @db.Text
  // Legacy OpenAI vector retained for rollback; new search uses Titan only.
  embedding   Unsupported("vector(1536)")?
  embeddingTitan Unsupported("vector(1024)")?
  indexStatus String @default("pending")
  retryAt     DateTime @default(now())
  attempts    Int @default(0)
  @@unique([messageId, ordinal])
  @@index([indexStatus, retryAt])
}
